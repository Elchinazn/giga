# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
# Бесплатный ключ с https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your-api-key

# --- Live-режим (нужен хотя бы один источник) ---
# Бесплатный ключ: https://dashboard.api-football.com/register (100 запросов в день)
API_FOOTBALL_KEY=
# MyScore: 1 — включён, 0 — выключен
MYSCORE_ENABLED=1
# Если MyScore изменит адрес потока или подпись — см. README
MYSCORE_FEED_URL=
MYSCORE_FSIGN=
# Как часто проверять матчи, за которыми следят пользователи (секунды)
LIVE_POLL_SECONDS=120
# Файл, где хранятся подписки на матчи (переживают перезапуск бота)
SUBS_FILE=subscriptions.json
# Часовой пояс для времени матчей
BOT_TIMEZONE=Europe/Moscow
